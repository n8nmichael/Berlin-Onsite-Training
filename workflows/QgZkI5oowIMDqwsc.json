    {
      "id": "344ecf62-a8de-4304-ac58-fe758bc4db64",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().filter((i) => Object.keys(i.json).length > 0);\nconst count = rows.length;\nlet html = '';\nif (count === 0) {\n  html = '<p>No new emails in the last 24 hours.</p>';\n} else {\n  const parts = rows.map((i) => {\n    const j = i.json;\n    const unread = Array.isArray(j.labels) && j.labels.some((l) => l.id === 'UNREAD');\n    const from = j.From || 'Unknown sender';\n    const subj = j.Subject || '(no subject)';\n    const snippet = j.snippet || '';\n    const flag = unread ? ' <strong>[unread]</strong>' : '';\n    return '<li><strong>' + subj + '</strong>' + flag + '<br/><em>' + from + '</em><br/>' + snippet + '</li>';\n  });\n  html = '<ul>' + parts.join('') + '</ul>';\n}\nconst subject = 'Email summary: ' + count + ' message' + (count === 1 ? '' : 's') + ' in the last 24h';\nreturn [{ json: { count, subject, html } }];"
      }
    },
    {
